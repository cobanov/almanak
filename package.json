{
  "name": "almanak",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && node scripts/build-demo.ts && tsc -b && vite build && node scripts/build-landing.ts && node scripts/check-network.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "inspect": "node scripts/inspect-archive.ts",
    "fixtures": "node scripts/fixture-redactor.ts",
    "harness": "node scripts/harness.ts",
    "demo": "node scripts/build-demo.ts",
    "check:network": "node scripts/check-network.ts",
    "publish:local": "npm run build && node scripts/publish-local.ts",
    "demo:archive": "node scripts/make-demo-archive.ts",
    "deploy": "npm run build && npx wrangler pages deploy dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@zip.js/zip.js": "^2.8.55",
    "comlink": "^4.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "description": "Read your X (Twitter) archive locally. Nothing is uploaded.",
  "license": "MIT",
  "author": "Mert Cobanov",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobanov/almanak.git"
  },
  "homepage": "https://almanak.cobanov.dev",
  "keywords": [
    "twitter",
    "x",
    "archive",
    "local-first",
    "privacy",
    "data-export",
    "turkish"
  ],
  "engines": {
    "node": ">=22.6"
  }
}
