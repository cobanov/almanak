# The app shell must not be cached: its asset filenames change every build.
/app/index.html
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Fingerprinted by the bundler — safe to cache hard.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The app is held to a stricter policy than the landing page: no remote host
# at all, which is the promise it makes to anyone opening an archive.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'none'; object-src 'none'

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  # The app reads archives from disk and talks to nothing. blob: covers media
  # object URLs and the module worker; styles are inlined by the bundler, hence
  # 'unsafe-inline' there and nowhere else. The one remote host is the visit
  # counter on the landing page — the app under /app/ never calls it, and the
  # stricter policy just below holds it to that.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://oa-c.cobanov.run; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://oa-c.cobanov.run; form-action 'none'; frame-ancestors 'self'; base-uri 'none'; object-src 'none'
